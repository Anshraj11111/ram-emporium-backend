# ================================================
# RAM EMPORIUM - Environment Variables
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── MongoDB ─────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ram-emporium?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Nodemailer / Gmail) ───────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="RAM EMPORIUM <your_email@gmail.com>"

# ── File Storage ────────────────────────────────
# Local path where PDFs will be stored
PDF_STORAGE_PATH=./public/pdfs
# Public base URL to serve PDFs
PDF_BASE_URL=http://localhost:5000/pdfs

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# ── Bcrypt ───────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── OTP ──────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── Logging ──────────────────────────────────────
LOG_LEVEL=info
